# Copy to .env and replace every placeholder. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
# Optional global prefix without slashes, e.g. api/v1
API_PREFIX=
# Comma-separated exact origins; empty disables CORS; * is rejected in production
CORS_ORIGINS=http://localhost:3001
# false | true | number of trusted proxy hops
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://app:app@localhost:5432/auth_dev
DATABASE_SSL=false
DATABASE_LOGGING=false

# --- JWT (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nestjs-boilerplate
JWT_AUDIENCE=nestjs-boilerplate-api

# --- Password hashing (argon2id; values can only go up from these minimums) ---
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# --- Rate limiting (global default; auth routes have stricter built-in limits) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Seed script only (npm run seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-Admin-password-1
